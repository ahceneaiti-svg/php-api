{
    "name": "app/user-api",
    "description": "RESTful user management API (Symfony + Redis)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-redis": "*",
        "symfony/console": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/yaml": "7.4.*"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "symfony/runtime": true
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "auto-scripts": [],
        "post-install-cmd": [],
        "post-update-cmd": []
    }
}
